<Window x:Class="IPKeep.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="IPKeep">
    <Grid x:Name="Root" RequestedTheme="Light" Background="{ThemeResource PageBackground}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{ThemeResource Surface}" BorderBrush="{ThemeResource SurfaceBorder}" BorderThickness="0,0,1,0">
            <Grid Padding="16,20,16,24" RowSpacing="24">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Image x:Name="BrandLogo" Source="Assets/Logo.png" Width="176" Height="64" Stretch="Uniform" AutomationProperties.Name="IPKeep" />
                <StackPanel Grid.Row="1" Spacing="6">
                    <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Click="Overview_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;" FontSize="18" /><TextBlock Text="Overview" /></StackPanel></Button>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="Settings_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="18" /><TextBlock Text="Settings" /></StackPanel></Button>
                    <Button x:Name="ActivityNav" Style="{StaticResource NavButton}" Click="Activity_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE81C;" FontSize="18" /><TextBlock Text="Activity" /></StackPanel></Button>
                    <Button x:Name="AppUpdatesNav" Style="{StaticResource NavButton}" Click="AppUpdates_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE896;" FontSize="18" /><TextBlock Text="App updates" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="3" Spacing="8">
                    <HyperlinkButton Content="Open IPKeep website ↗" NavigateUri="https://admin.ipkeep.net/" FontSize="12" Padding="8" />
                    <TextBlock x:Name="AppVersionText" FontSize="11" Foreground="{ThemeResource Muted}" Margin="8,0,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Padding="32,24" RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Spacing="12">
            <InfoBar x:Name="AccessBanner" IsOpen="False" IsClosable="False" Severity="Informational" AutomationProperties.Name="Service changes" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="12" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Service changes" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Allow changes to save settings or manage the background service." TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Grid Grid.Column="2">
                        <Canvas x:Name="AccessGlowHost" IsHitTestVisible="False" />
                        <Button x:Name="AllowChangesButton" Content="Allow changes" Click="Elevate_Click" Background="{ThemeResource Surface}">
                            <Button.Resources><SolidColorBrush x:Key="AccessHintGlowBrush" Color="{ThemeResource AccessHintGlowColor}" /></Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </InfoBar>
            <InfoBar x:Name="AppUpdateBanner" IsOpen="False" IsClosable="True" Severity="Informational" Title="A new version of IPKeep is available.">
                <InfoBar.ActionButton><Button Content="View changes" Click="AppUpdates_Click" /></InfoBar.ActionButton>
            </InfoBar>
            </StackPanel>
            <ScrollViewer x:Name="AppUpdatesPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="24" Padding="0,0,8,8">
                    <StackPanel Spacing="6"><TextBlock Text="App updates" Style="{StaticResource PageTitle}" /><TextBlock Text="Get the latest improvements to IPKeep for Windows." TextWrapping="Wrap" Foreground="{ThemeResource Muted}" /></StackPanel>
                    <Border x:Name="AvailableAppUpdate" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel Spacing="14">
                        <TextBlock x:Name="AvailableVersionText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="AppReleaseDateText" Foreground="{ThemeResource Muted}" />
                        <TextBox x:Name="AppReleaseNotes" Header="What's changed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="112" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Release notes" />
                        <TextBlock x:Name="InstallerDownloadStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="InstallerDownloadProgress" Visibility="Collapsed" Minimum="0" Maximum="100" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="InstallAppUpdateButton" Content="Download update" Click="InstallAppUpdate_Click" Style="{StaticResource AccentButtonStyle}" Padding="20,10" />
                            <Button x:Name="CancelAppDownloadButton" Content="Cancel download" Click="CancelAppDownload_Click" Visibility="Collapsed" />
                        </StackPanel>
                        <HyperlinkButton Content="Download from GitHub instead ↗" Click="DownloadAppUpdate_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="This beta is unsigned. Install update opens Windows setup and closes IPKeep after approval. Your saved settings and service connection are kept." TextWrapping="Wrap" Foreground="{ThemeResource Muted}" FontSize="12" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="14">
                        <TextBlock x:Name="InstalledVersionText" FontWeight="SemiBold" />
                        <ToggleSwitch x:Name="AutomaticDownloadSwitch" Header="Download updates automatically" OnContent="On — ask before installing" OffContent="Off — notify only" Toggled="AutomaticDownload_Toggled" />
                        <TextBlock x:Name="AppUpdateStatus" Text="Checking for updates…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="CheckAppUpdatesButton" Content="Check for updates" Click="CheckAppUpdates_Click" />
                        <TextBlock x:Name="AppUpdateCheckHint" TextWrapping="Wrap" Foreground="{ThemeResource Muted}" FontSize="12" />
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="OverviewPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="24" Padding="0,0,8,8">
                    <StackPanel Spacing="6"><TextBlock Text="Your connection, at a glance." Style="{StaticResource PageTitle}" TextWrapping="Wrap" /><TextBlock Text="Background updates for your IPKeep hostnames." Foreground="{ThemeResource Muted}" /></StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="10"><Ellipse x:Name="StatusDot" Width="9" Height="9" Style="{StaticResource NeutralStatusDot}" /><TextBlock x:Name="StatusLabel" Text="Ready to set up" FontWeight="SemiBold" Foreground="{ThemeResource Muted}" /></StackPanel>
                            <TextBlock x:Name="StatusTitle" Text="Keep your connections current." FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="StatusMessage" Text="Add your IPKeep API token in Settings, then choose a hostname from your account." TextWrapping="Wrap" Foreground="{ThemeResource Muted}" LineHeight="23" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="PrimaryAction" Content="Set up IPKeep" Style="{StaticResource AccentButtonStyle}" Click="Primary_Click" Padding="20,10" />
                                <Button x:Name="PauseButton" Content="Pause updates" Click="Pause_Click" Visibility="Collapsed" Padding="16,10" />
                                <ProgressRing x:Name="BusyRing" IsActive="False" Width="22" Height="22" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="24" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.ColumnSpan="2" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Public addresses" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /><Button x:Name="RefreshAddressesButton" Grid.Column="1" Content="Refresh addresses" Click="RefreshAddresses_Click" VerticalAlignment="Center" /></Grid>
                            <StackPanel Grid.Row="1" Spacing="8"><TextBlock Text="PUBLIC IPv4" FontSize="11" Foreground="{ThemeResource Muted}" /><TextBlock x:Name="IPv4Text" Text="Checking…" FontSize="18" IsTextSelectionEnabled="True" /><TextBlock x:Name="IPv4Hint" Text="Looking up this connection" FontSize="12" Foreground="{ThemeResource Muted}" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8"><TextBlock Text="PUBLIC IPv6" FontSize="11" Foreground="{ThemeResource Muted}" /><TextBlock x:Name="IPv6Text" Text="Checking…" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><TextBlock x:Name="IPv6Hint" Text="Looking up this connection" FontSize="12" Foreground="{ThemeResource Muted}" TextWrapping="Wrap" /></StackPanel>
                            <TextBlock x:Name="LookupSourceText" Grid.Row="2" Grid.ColumnSpan="2" Text="IP lookup: IPKeep. No token needed." FontSize="12" Foreground="{ThemeResource Muted}" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="3" Spacing="8"><TextBlock Text="LAST COMPLETED HOST CHECK" FontSize="11" Foreground="{ThemeResource Muted}" /><TextBlock x:Name="LastCheckText" Text="—" /></StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="8"><TextBlock Text="NEXT HOST UPDATE CHECK" FontSize="11" Foreground="{ThemeResource Muted}" /><TextBlock x:Name="NextCheckText" Text="—" /></StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Spacing="12"><TextBlock Text="Your hostnames" Style="{StaticResource SectionTitle}" /><ItemsControl x:Name="HostsList"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{ThemeResource Surface}" BorderBrush="{ThemeResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,8"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="6" VerticalAlignment="Center"><TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" IsTextSelectionEnabled="True" TextWrapping="Wrap" /><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{ThemeResource Muted}" /></StackPanel><Button Grid.Column="1" Content="Diagnostics" Tag="{Binding Hostname}" Click="Diagnostics_Click" VerticalAlignment="Center" AutomationProperties.Name="Run network diagnostics" /></Grid></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoHostsText" Text="Your configured hostnames will appear here." Foreground="{ThemeResource Muted}" /></StackPanel>
                    <TextBlock Text="Once enabled, IPKeep keeps running when you close this window or sign out." TextWrapping="Wrap" Foreground="{ThemeResource Muted}" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="22" Padding="0,0,8,8">
                    <InfoBar x:Name="ConnectionRecoveryBanner" IsOpen="False" IsClosable="False" Severity="Warning" />
                    <StackPanel Spacing="6"><TextBlock x:Name="ConnectionTitle" Text="Set up this computer." Style="{StaticResource PageTitle}" TextWrapping="Wrap" /><TextBlock x:Name="ConnectionSubtitle" Text="Install the background service and verify your token to finish setup." Foreground="{ThemeResource Muted}" TextWrapping="Wrap" /></StackPanel>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
                        <TextBlock Text="1. Background service" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="ServiceSetupDot" Width="8" Height="8" Style="{StaticResource WarningStatusDot}" />
                            <TextBlock x:Name="ServiceSetupStatus" Text="Not installed" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <TextBlock x:Name="ServiceSetupHint" Text="Install the service so IPKeep can update your hostnames even when this window is closed. Then connect your account below." Foreground="{ThemeResource Muted}" TextWrapping="Wrap" />
                        <Button x:Name="InstallServiceButton" Content="Install service" Style="{StaticResource AccentButtonStyle}" Click="InstallService_Click" Padding="20,10" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><ContentControl x:Name="ConnectionForm" HorizontalContentAlignment="Stretch"><StackPanel Spacing="14">
                        <TextBlock Text="2. Connect your account" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="TokenSetupDot" Width="8" Height="8" Style="{StaticResource WarningStatusDot}" />
                            <TextBlock x:Name="TokenSetupStatus" Text="Token required" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <PasswordBox x:Name="TokenBox" Header="IPKeep API token" PlaceholderText="Paste the token from the admin panel" PasswordRevealMode="Peek" PasswordChanged="Token_Changed" />
                        <TextBlock x:Name="TokenHint" Text="Your token is encrypted for your Windows user after verification. It never appears in logs." FontSize="12" Foreground="{ThemeResource Muted}" TextWrapping="Wrap" />
                        <Button x:Name="LoadHostsButton" Content="Load my hostnames" Click="LoadHosts_Click" HorizontalAlignment="Left" />
                        <StackPanel x:Name="HostnameSection" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="HostnameLabel" Text="Hostnames for this computer" />
                            <Border x:Name="SingleHostnamePanel" BorderBrush="{ThemeResource SurfaceBorder}" BorderThickness="1" CornerRadius="4" Padding="12,8" Visibility="Collapsed">
                                <TextBlock x:Name="SingleHostnameText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </Border>
                            <DropDownButton x:Name="HostnameDropdown" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed" AutomationProperties.Name="Hostnames for this computer">
                                <TextBlock x:Name="HostnameSummary" Text="Choose hostnames" TextTrimming="CharacterEllipsis" />
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="HostnameFlyout" Opening="Hostnames_Opening" Placement="BottomEdgeAlignedLeft">
                                        <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="Padding" Value="12" /><Setter Property="MaxWidth" Value="680" /></Style></Flyout.FlyoutPresenterStyle>
                                        <StackPanel x:Name="HostnameFlyoutContent" Spacing="8" Width="360">
                                            <TextBlock Text="Choose hostnames" FontWeight="SemiBold" />
                                            <TextBlock x:Name="HostnameSelectionCount" Text="0 of 5 selected" Foreground="{ThemeResource Muted}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                            <ListView x:Name="HostnameList" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" MaxHeight="288" SelectionChanged="Hostnames_Changed" ContainerContentChanging="Hostnames_ContainerChanging" AutomationProperties.Name="Select up to 5 hostnames">
                                                <ListView.Resources>
                                                    <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedBrush" Color="{ThemeResource HostnameCheckColor}" />
                                                    <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedPointerOverBrush" Color="{ThemeResource HostnameCheckColor}" />
                                                    <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedPressedBrush" Color="{ThemeResource HostnameCheckColor}" />
                                                    <SolidColorBrush x:Key="ListViewItemCheckBrush" Color="{ThemeResource HostnameCheckmarkColor}" />
                                                    <SolidColorBrush x:Key="ListViewItemCheckPressedBrush" Color="{ThemeResource HostnameCheckmarkColor}" />
                                                </ListView.Resources>
                                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="8,4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                        <TextBlock x:Name="HostListHint" Text="Hostnames are created and managed only in the IPKeep admin panel." FontSize="12" Foreground="{ThemeResource Muted}" TextWrapping="Wrap" />
                        <HyperlinkButton Content="Open the admin panel ↗" NavigateUri="https://admin.ipkeep.net/" HorizontalAlignment="Left" Padding="0,4" />
                        <StackPanel x:Name="HostOptionsPanel" Spacing="14" Visibility="Collapsed">
                        <ComboBox x:Name="IpLookupBox" Header="IP lookup service" HorizontalAlignment="Stretch" IsEditable="False" MaxDropDownHeight="360" DropDownOpened="IpLookup_Opened" SelectionChanged="IpLookup_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Spacing="3" Padding="0,3" ToolTipService.ToolTip="{Binding Help}">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{ThemeResource Muted}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="IpLookupHint" Text="Open the list to compare IPv4 addresses. VPN routing can give each service a different address." FontSize="12" Foreground="{ThemeResource Muted}" TextWrapping="Wrap" />
                        <Expander Header="Advanced options" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="16">
                            <NumberBox x:Name="IntervalBox" Header="Check every (minutes)" Value="360" Minimum="1" Maximum="1440" SmallChange="5" SpinButtonPlacementMode="Compact" Description="Default: 6 hours. Failed checks retry after 5 minutes." />
                            <ToggleSwitch x:Name="IPv6Switch" Header="Also update IPv6" OnContent="IPv4 and IPv6" OffContent="IPv4 only" />
                            <TextBlock x:Name="IPv6SettingHint" Text="Enable IPv6 only if this computer has a public IPv6 connection. Missing or ignored addresses never clear saved addresses." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource Muted}" />
                            <TextBox x:Name="IgnoreBox" Header="Ignore IP addresses or networks (optional)" PlaceholderText="198.51.100.0/24" AcceptsReturn="True" TextWrapping="Wrap" Description="One IP address or CIDR range per line. Useful for VPN exits." />
                        </StackPanel></Expander>
                        <Button x:Name="SaveButton" Content="Save and enable updates" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" Padding="20,10" />
                        </StackPanel>
                    </StackPanel></ContentControl></Border>
                    <Expander x:Name="ServiceMaintenanceExpander" Header="Service maintenance" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <TextBlock Text="Repair or update the installed service from this download, or remove it. Removing it keeps your saved connection and activity." TextWrapping="Wrap" Foreground="{ThemeResource Muted}" />
                        <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="RepairButton" Content="Repair / update service" Click="Repair_Click" /><Button x:Name="RemoveButton" Content="Remove service" Click="Remove_Click" /></StackPanel>
                    </StackPanel></Expander>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="ActivityPage" Grid.Row="1" Visibility="Collapsed" RowSpacing="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="6"><TextBlock Text="Activity" Style="{StaticResource PageTitle}" /><TextBlock Text="Recent checks and service events. Newest first. Times are local." Foreground="{ThemeResource Muted}" TextWrapping="Wrap" /></StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="LogFilterBox" PlaceholderText="Filter activity…" TextChanged="Filter_Changed" AutomationProperties.Name="Filter activity" /><Button Grid.Column="1" Content="Open log folder" Click="OpenLogs_Click" /></Grid>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{ThemeResource TableHeader}" BorderBrush="{ThemeResource SurfaceBorder}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="12,8,28,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Time (local)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource Muted}" />
                                <TextBlock Grid.Column="1" Text="Level" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource Muted}" />
                                <TextBlock Grid.Column="2" Text="Message" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource Muted}" />
                            </Grid>
                        </Border>
                        <ListView x:Name="LogList" Grid.Row="1" SelectionMode="None" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.Name="Activity: local time, level, and message">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" />
                            </Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate><DataTemplate>
                                <Border Style="{StaticResource ActivityRow}" PointerEntered="ActivityRow_PointerEntered" PointerExited="ActivityRow_Reset" PointerCanceled="ActivityRow_Reset" Unloaded="ActivityRow_Reset">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimestampText}" ToolTipService.ToolTip="{Binding TimestampDetails}" FontSize="12" Foreground="{ThemeResource Muted}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="12" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" ToolTipService.ToolTip="{Binding RawLine}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Grid>
                                </Border>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyLogText" Grid.Row="1" Text="Activity will appear after your first check." Foreground="{ThemeResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16" />
                    </Grid>
                </Border>
            </Grid>
            <InfoBar x:Name="Feedback" Grid.Row="2" IsOpen="False" IsClosable="True" />
        </Grid>
    </Grid>
</Window>
