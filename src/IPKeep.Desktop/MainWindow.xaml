<Window x:Class="IPKeep.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="IPKeep">
    <Grid x:Name="Root" RequestedTheme="Light" Background="#F6F8FB">
        <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="#E5EAF0" BorderThickness="0,0,1,0">
            <Grid Padding="16,20,16,24" RowSpacing="24">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Image Source="Assets/Logo.png" Width="176" Height="64" Stretch="Uniform" AutomationProperties.Name="IPKeep" />
                <StackPanel Grid.Row="1" Spacing="6">
                    <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Click="Overview_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;" FontSize="18" /><TextBlock Text="Overview" /></StackPanel></Button>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="Settings_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="18" /><TextBlock Text="Settings" /></StackPanel></Button>
                    <Button x:Name="ActivityNav" Style="{StaticResource NavButton}" Click="Activity_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE81C;" FontSize="18" /><TextBlock Text="Activity" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="3" Spacing="8">
                    <HyperlinkButton Content="Open IPKeep website ↗" NavigateUri="https://admin.ipkeep.net/" FontSize="12" Padding="8" />
                    <TextBlock Text="IPKeep for Windows · 1.0" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Padding="32,24" RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <InfoBar x:Name="AccessBanner" IsOpen="True" IsClosable="False" Severity="Informational" Title="Service changes" Message="Allow changes to save settings or manage the background service.">
                <InfoBar.ActionButton><Button Content="Allow changes" Click="Elevate_Click" /></InfoBar.ActionButton>
            </InfoBar>
            <ScrollViewer x:Name="OverviewPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="24" Padding="0,0,8,8">
                    <StackPanel Spacing="6"><TextBlock Text="Your connection, at a glance." Style="{StaticResource PageTitle}" TextWrapping="Wrap" /><TextBlock Text="Background updates for your IPKeep hostnames." Foreground="{StaticResource Muted}" /></StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="10"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#64748B" /><TextBlock x:Name="StatusLabel" Text="Ready to set up" FontWeight="SemiBold" Foreground="{StaticResource Muted}" /></StackPanel>
                            <TextBlock x:Name="StatusTitle" Text="Keep your connections current." FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="StatusMessage" Text="Add your IPKeep API token in Settings, then choose a hostname from your account." TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="23" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="PrimaryAction" Content="Set up IPKeep" Style="{StaticResource AccentButtonStyle}" Click="Primary_Click" Padding="20,10" />
                                <Button x:Name="PauseButton" Content="Pause updates" Click="Pause_Click" Visibility="Collapsed" Padding="16,10" />
                                <ProgressRing x:Name="BusyRing" IsActive="False" Width="22" Height="22" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="24" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="8"><TextBlock Text="PUBLIC IPv4" FontSize="11" Foreground="{StaticResource Muted}" /><TextBlock x:Name="IPv4Text" Text="Checking…" FontSize="18" IsTextSelectionEnabled="True" /><TextBlock x:Name="IPv4Hint" Text="Looking up this connection" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="PUBLIC IPv6" FontSize="11" Foreground="{StaticResource Muted}" /><TextBlock x:Name="IPv6Text" Text="Checking…" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><TextBlock x:Name="IPv6Hint" Text="Looking up this connection" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="LookupSourceText" Text="IP lookup: IPKeep. No token needed." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" /><Button x:Name="RefreshAddressesButton" Grid.Column="1" Content="Refresh addresses" Click="RefreshAddresses_Click" /></Grid>
                            <StackPanel Grid.Row="2" Spacing="8"><TextBlock Text="LAST HOST UPDATE CHECK" FontSize="11" Foreground="{StaticResource Muted}" /><TextBlock x:Name="LastCheckText" Text="—" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8"><TextBlock Text="NEXT HOST UPDATE CHECK" FontSize="11" Foreground="{StaticResource Muted}" /><TextBlock x:Name="NextCheckText" Text="—" /></StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Spacing="12"><TextBlock Text="Your hostnames" Style="{StaticResource SectionTitle}" /><ItemsControl x:Name="HostsList"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="White" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,8"><StackPanel Spacing="6"><TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" IsTextSelectionEnabled="True" TextWrapping="Wrap" /><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" /></StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoHostsText" Text="Your configured hostnames will appear here." Foreground="{StaticResource Muted}" /></StackPanel>
                    <TextBlock Text="Once enabled, IPKeep keeps running when you close this window or sign out." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="22" Padding="0,0,8,8">
                    <StackPanel Spacing="6"><TextBlock x:Name="ConnectionTitle" Text="Connect this computer." Style="{StaticResource PageTitle}" TextWrapping="Wrap" /><TextBlock x:Name="ConnectionSubtitle" Text="Add your token to connect this computer to your hostnames." Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
                    <Border Style="{StaticResource Card}"><ContentControl x:Name="ConnectionForm" HorizontalContentAlignment="Stretch"><StackPanel Spacing="14">
                        <PasswordBox x:Name="TokenBox" Header="1. IPKeep API token" PlaceholderText="Paste the token from the admin panel" PasswordRevealMode="Peek" PasswordChanged="Token_Changed" />
                        <TextBlock x:Name="TokenHint" Text="Your token is encrypted for your Windows user after verification. It never appears in logs." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        <Button x:Name="LoadHostsButton" Content="Load my hostnames" Click="LoadHosts_Click" HorizontalAlignment="Left" />
                        <StackPanel x:Name="HostnameSection" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="HostnameLabel" Text="2. Hostnames for this computer" />
                            <Border x:Name="SingleHostnamePanel" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="4" Padding="12,8" Visibility="Collapsed">
                                <TextBlock x:Name="SingleHostnameText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </Border>
                            <DropDownButton x:Name="HostnameDropdown" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed" AutomationProperties.Name="Hostnames for this computer">
                                <TextBlock x:Name="HostnameSummary" Text="Choose hostnames" TextTrimming="CharacterEllipsis" />
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="HostnameFlyout" Opening="Hostnames_Opening" Placement="BottomEdgeAlignedLeft">
                                        <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="Padding" Value="12" /><Setter Property="MaxWidth" Value="680" /></Style></Flyout.FlyoutPresenterStyle>
                                        <StackPanel x:Name="HostnameFlyoutContent" Spacing="8" Width="360">
                                            <TextBlock Text="Choose hostnames" FontWeight="SemiBold" />
                                            <TextBlock x:Name="HostnameSelectionCount" Text="0 of 5 selected" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                            <ListView x:Name="HostnameList" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" MaxHeight="288" SelectionChanged="Hostnames_Changed" ContainerContentChanging="Hostnames_ContainerChanging" AutomationProperties.Name="Select up to 5 hostnames">
                                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="8,4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                        <TextBlock x:Name="HostListHint" Text="Hostnames are created and managed only in the IPKeep admin panel." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        <HyperlinkButton Content="Open the admin panel ↗" NavigateUri="https://admin.ipkeep.net/" HorizontalAlignment="Left" Padding="0,4" />
                        <StackPanel x:Name="HostOptionsPanel" Spacing="14" Visibility="Collapsed">
                        <ComboBox x:Name="IpLookupBox" Header="IP lookup service" HorizontalAlignment="Stretch" IsEditable="False" MaxDropDownHeight="360" DropDownOpened="IpLookup_Opened" SelectionChanged="IpLookup_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Spacing="3" Padding="0,3" ToolTipService.ToolTip="{Binding Help}">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource Muted}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="IpLookupHint" Text="Open the list to compare IPv4 addresses. VPN routing can give each service a different address." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        <Expander Header="Advanced options" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="16">
                            <NumberBox x:Name="IntervalBox" Header="Check every (minutes)" Value="360" Minimum="1" Maximum="1440" SmallChange="5" SpinButtonPlacementMode="Compact" Description="Default: 6 hours. Failed checks retry after 5 minutes." />
                            <ToggleSwitch x:Name="IPv6Switch" Header="Also update IPv6" OnContent="IPv4 and IPv6" OffContent="IPv4 only" />
                            <TextBlock x:Name="IPv6SettingHint" Text="Enable IPv6 only if this computer has a public IPv6 connection. Missing or ignored addresses never clear saved addresses." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" />
                            <TextBox x:Name="IgnoreBox" Header="Ignore IP addresses or networks (optional)" PlaceholderText="198.51.100.0/24" AcceptsReturn="True" TextWrapping="Wrap" Description="One IP address or CIDR range per line. Useful for VPN exits." />
                        </StackPanel></Expander>
                        <Button x:Name="SaveButton" Content="Save and enable updates" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" Padding="20,10" />
                        </StackPanel>
                    </StackPanel></ContentControl></Border>
                    <Expander x:Name="ServiceMaintenanceExpander" Header="Service maintenance" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <TextBlock Text="Install an updated service from this download, or remove the background service. Removing it keeps your saved connection and activity." TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                        <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="RepairButton" Content="Install / update service" Click="Repair_Click" /><Button x:Name="RemoveButton" Content="Remove service" Click="Remove_Click" /></StackPanel>
                    </StackPanel></Expander>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="ActivityPage" Grid.Row="1" Visibility="Collapsed" RowSpacing="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="6"><TextBlock Text="Activity" Style="{StaticResource PageTitle}" /><TextBlock Text="Recent checks and service events. Newest first. Times are local." Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="LogFilterBox" PlaceholderText="Filter activity…" TextChanged="Filter_Changed" AutomationProperties.Name="Filter activity" /><Button Grid.Column="1" Content="Open log folder" Click="OpenLogs_Click" /></Grid>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="12,8,28,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Time (local)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="1" Text="Level" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="2" Text="Message" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                            </Grid>
                        </Border>
                        <ListView x:Name="LogList" Grid.Row="1" SelectionMode="None" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.Name="Activity: local time, level, and message">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" />
                            </Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate><DataTemplate>
                                <Border BorderBrush="#EEF1F5" BorderThickness="0,0,0,1" Padding="12,5,28,5">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimestampText}" ToolTipService.ToolTip="{Binding TimestampDetails}" FontSize="12" Foreground="{StaticResource Muted}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="12" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" ToolTipService.ToolTip="{Binding RawLine}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Grid>
                                </Border>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyLogText" Grid.Row="1" Text="Activity will appear after your first check." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16" />
                    </Grid>
                </Border>
            </Grid>
            <InfoBar x:Name="Feedback" Grid.Row="2" IsOpen="False" IsClosable="True" />
        </Grid>
    </Grid>
</Window>
