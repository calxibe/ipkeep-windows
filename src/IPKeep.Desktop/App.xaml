<Application x:Class="IPKeep.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="BrandBlue" Color="#285FD5" />
            <SolidColorBrush x:Key="Muted" Color="#64748B" />
            <SolidColorBrush x:Key="Ink" Color="#1E3044" />
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E5EAF0" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="24" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Style>
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="16,12" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="15" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
